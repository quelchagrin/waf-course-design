    {"name": "反引号替换 `id`", "location": "url", "expect": "block", "path": "/ping?host=%60id%60"},
    {"name": "绕过1：${IFS} 代替空格", "location": "url", "expect": "block", "path": "/ping?host=127.0.0.1%24%7BIFS%7Dwhoami"},
    {"name": "绕过2：换行执行新命令", "location": "url", "expect": "block", "path": "/ping?host=127.0.0.1%0Awhoami"},
    {"name": "绕过3：引号拼接 c'a't", "location": "url", "expect": "block", "path": "/ping?host=127.0.0.1%3Bc%27a%27t%20/etc/passwd"},
